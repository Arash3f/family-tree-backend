meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: isDefined
  res.body.postgres: isDefined
  res.body.neo4j: isDefined
}

docs {
  # Health

  ## Input
  None

  ## Output `200`
  ```json
  {
    "postgres": "ok",
    "neo4j": "ok",
    "status": "ok"
  }
  ```

  `status` is `ok` when both databases are healthy, otherwise `degraded`.
}
