meta {
  name: Create Role
  type: http
  seq: 1
}

post {
  url: {{base_url}}/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "editor",
    "permission_ids": []
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.name: isString
  res.body.permission_ids: isArray
}

script:post-response {
  if ((res.status === 200 || res.status === 201) && res.body.id) {
    bru.setEnvVar("role_id", String(res.body.id));
  }
}

docs {
  # Create Role

  ## Input (`application/json`)
  | Field | Type | Required | Notes |
  |-------|------|----------|-------|
  | name | string\|null | yes | |
  | permission_ids | uuid[]\|null | yes | Use List Permissions to get IDs |

  ## Output `201`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000001",
    "name": "editor",
    "permission_ids": []
  }
  ```
}
