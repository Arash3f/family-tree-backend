meta {
  name: Create Person
  type: http
  seq: 1
}

post {
  url: {{base_url}}/persons/
  body: json
  auth: inherit
}

body:json {
  {
    "name": "arash",
    "family_name": "karimi",
    "gender": "male",
    "birth_date": "1379/09/01",
    "death_date": null,
    "birth_place": "Tehran",
    "death_place": null,
    "notes": null,
    "parents": [],
    "marriage_id": null,
    "photo_object_key": null
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
  res.body.name: isString
  res.body.gender: isDefined
}

script:post-response {
  if (res.status === 200 && res.body.id) {
    const id = String(res.body.id);
    const previous = bru.getEnvVar("person_id");
    bru.setEnvVar("person_id", id);
    if (previous && previous !== id) {
      bru.setEnvVar("from_person_id", previous);
      bru.setEnvVar("to_person_id", id);
    } else {
      bru.setEnvVar("from_person_id", id);
    }
  }
}

docs {
  # Create Person

  ## Input (`application/json`)
  | Field | Type | Required | Notes |
  |-------|------|----------|-------|
  | name | string | yes | Given name |
  | family_name | string\|null | no | Family / surname |
  | gender | string | yes | `male` \| `female` |
  | birth_date | string\|null | no | Jalali `YYYY/MM/DD` or Gregorian `YYYY-MM-DD` |
  | death_date | string\|null | no | Must be >= birth_date when both set |
  | birth_place | string\|null | no | |
  | death_place | string\|null | no | |
  | notes | string\|null | no | Free-form notes |
  | parents | array | no | `{ parent_id, relationship_type }` |
  | marriage_id | uuid\|null | no | Origin marriage |
  | photo_object_key | string\|null | no | From `POST /media/upload` |

  ## Output `200`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000001",
    "name": "arash",
    "family_name": "karimi",
    "gender": "male",
    "birth_date": "1379/09/01",
    "death_date": null,
    "birth_place": "Tehran",
    "death_place": null,
    "notes": null,
    "parents": [],
    "marriage_id": null,
    "photo_object_key": null,
    "photo_url": null
  }
  ```
}
