meta {
  name: Update Person
  type: http
  seq: 3
}

put {
  url: {{base_url}}/persons/
  body: json
  auth: inherit
}

body:json {
  {
    "data": {
      "name": "arash updated",
      "family_name": "karimi",
      "gender": "male",
      "birth_date": "1379/09/01",
      "birth_place": "Tehran",
      "notes": "updated note",
      "parents": [],
      "marriage_id": null
    },
    "where": {
      "person_id": "{{person_id}}"
    }
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
  res.body.name: isString
}

docs {
  # Update Person

  ## Input (`application/json`)
  ```json
  {
    "data": {
      "name": "string|null",
      "family_name": "string|null",
      "gender": "male|female|null",
      "birth_date": "Jalali/Gregorian|null",
      "death_date": "Jalali/Gregorian|null",
      "birth_place": "string|null",
      "death_place": "string|null",
      "notes": "string|null",
      "parents": "[{parent_id, relationship_type}]|null",
      "marriage_id": "uuid|null"
    },
    "where": {
      "person_id": "uuid (required)"
    }
  }
  ```

  ## Output `200`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000001",
    "name": "arash updated",
    "family_name": "karimi",
    "gender": "male",
    "birth_date": "1379-09-01",
    "birth_place": "Tehran",
    "notes": "updated note",
    "parents": [],
    "marriage_id": null
  }
  ```
}
