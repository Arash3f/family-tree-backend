meta {
  name: Update Person
  type: http
  seq: 3
}

put {
  url: {{base_url}}/persons/
  body: json
  auth: inherit
}

body:json {
  {
    "data": {
      "name": "arash updated",
      "gender": "male",
      "birth_date": "1379/09/01",
      "father_id": null,
      "mother_id": null
    },
    "where": {
      "person_id": {{person_id}}
    }
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
  res.body.name: isString
}

docs {
  # Update Person

  ## Input (`application/json`)
  ```json
  {
    "data": {
      "name": "string|null",
      "gender": "male|female|null",
      "birth_date": "Jalali/Gregorian|null",
      "father_id": "uuid|null",
      "mother_id": "uuid|null"
    },
    "where": {
      "person_id": "uuid (required)"
    }
  }
  ```

  ## Output `200`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000001",
    "name": "arash updated",
    "gender": "male",
    "birth_date": "1379-09-01",
    "father_id": null,
    "mother_id": null
  }
  ```
}
