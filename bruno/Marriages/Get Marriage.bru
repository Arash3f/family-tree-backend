meta {
  name: Get Marriage
  type: http
  seq: 2
}

get {
  url: {{base_url}}/family-trees/{{tree_id}}/marriages/{{marriage_id}}
  body: none
  auth: inherit
}

params:path {
  marriage_id: {{marriage_id}}
}

assert {
  res.status: eq 200
  res.body.id: isString
  res.body.spouse_a_id: isString
  res.body.spouse_b_id: isString
}

docs {
  # Get Marriage

  ## Input (path)
  | Param | Type | Required |
  |-------|------|----------|
  | marriage_id | uuid | yes |

  ## Output `200`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000001",
    "spouse_a_id": "00000000-0000-0000-0000-000000000001",
    "spouse_b_id": "00000000-0000-0000-0000-000000000002",
    "married_at": "2020-01-15",
    "divorced_at": null
  }
  ```
}
