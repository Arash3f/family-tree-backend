meta {
  name: Update Marriage
  type: http
  seq: 3
}

put {
  url: {{base_url}}/marriages/
  body: json
  auth: inherit
}

body:json {
  {
    "data": {
      "husband_id": "00000000-0000-0000-0000-000000000001",
      "wife_id": "00000000-0000-0000-0000-000000000002",
      "married_at": "2020-01-15",
      "divorced_at": null
    },
    "where": {
      "marriage_id": {{marriage_id}}
    }
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
}

docs {
  # Update Marriage

