meta {
  name: Create Marriage
  type: http
  seq: 1
}

post {
  url: {{base_url}}/family-trees/{{tree_id}}/marriages/
  body: json
  auth: inherit
}

body:json {
  {
    "spouse_a_id": "{{from_person_id}}",
    "spouse_b_id": "{{to_person_id}}",
    "married_at": "2020-01-15"
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
  res.body.spouse_a_id: isString
  res.body.spouse_b_id: isString
  res.body.married_at: isDefined
}

script:post-response {
  if (res.status === 200 && res.body.id) {
    bru.setEnvVar("marriage_id", String(res.body.id));
  }
}

docs {
  # Create Marriage

  ## Input (`application/json`)
  | Field | Type | Required | Notes |
  |-------|------|----------|-------|
  | spouse_a_id | uuid | yes | Person uuid |
  | spouse_b_id | uuid | yes | Person uuid |
  | married_at | date | yes | `YYYY-MM-DD` |

  ## Output `200`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000001",
    "spouse_a_id": "00000000-0000-0000-0000-000000000001",
    "spouse_b_id": "00000000-0000-0000-0000-000000000002",
    "married_at": "2020-01-15",
    "divorced_at": null
  }
  ```
}
