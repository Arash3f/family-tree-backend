meta {
  name: Delete Marriage
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/family-trees/{{tree_id}}/marriages
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{marriage_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.result: isDefined
}

