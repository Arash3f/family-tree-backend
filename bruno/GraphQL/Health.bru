meta {
  name: Health
  type: http
  seq: 3
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}

docs {
  # Health (shared)

  GraphQL does not expose a separate health field; use REST `/health`.
  HTTP `200` with `status: ok`, or HTTP `503` with `status: degraded`.
}
