meta {
  name: Family Trees
  type: graphql
  seq: 4
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query: '''
    query FamilyTrees {
      familyTrees {
        id
        name
        ownerUserId
      }
    }
  '''
}

assert {
  res.status: eq 200
  res.body.data.familyTrees: isArray
}

docs {
  # GraphQL Family Trees

  Equivalent to REST `GET /family-trees`. Returns only the caller's trees.
}
