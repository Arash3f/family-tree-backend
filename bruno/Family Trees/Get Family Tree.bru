meta {
  name: Get Family Tree
  type: http
  seq: 3
}

get {
  url: {{base_url}}/family-trees/{{tree_id}}
  body: none
  auth: inherit
}

params:path {
  tree_id: {{tree_id}}
}

assert {
  res.status: eq 200
  res.body.id: isString
  res.body.name: isString
  res.body.owner_user_id: isString
}

docs {
  # Get Family Tree

  Non-members get `403` even with the `tree:read` permission.

  ## Input (path)
  | Param | Type | Required |
  |-------|------|----------|
  | tree_id | uuid | yes |

  ## Output `200`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000001",
    "name": "Karimi family",
    "owner_user_id": "00000000-0000-0000-0000-000000000002"
  }
  ```
}
