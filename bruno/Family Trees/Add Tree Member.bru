meta {
  name: Add Tree Member
  type: http
  seq: 6
}

post {
  url: {{base_url}}/family-trees/{{tree_id}}/members
  body: json
  auth: inherit
}

params:path {
  tree_id: {{tree_id}}
}

body:json {
  {
    "username": "new_user",
    "permissions": ["view"]
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.tree_id: isString
  res.body.user_id: isString
  res.body.role: eq member
}

docs {
  # Add Tree Member

  Requires permission `tree_member_add`. The new member joins with the `member`
  role, and `permissions` decides what they can actually do inside the tree.
  Adding the same user twice returns `409`.

  Run Users / Create User first so the username points at a real account.

  ## Input (path + `application/json`)
  | Field | Type | Required | Notes |
  |-------|------|----------|-------|
  | tree_id | uuid | yes (path) | |
  | username | string | yes | 1-100 chars |
  | permissions | string[] | no | `view`, `edit`, `add_persons`; defaults to `view` |

  Permissions cascade, so asking for `edit` or `add_persons` also grants
  `view`. An unknown name returns `422`. Use Update Tree Member to change
  access later.

  ## Output `201`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000003",
    "tree_id": "00000000-0000-0000-0000-000000000001",
    "user_id": "00000000-0000-0000-0000-000000000002",
    "role": "member",
    "permissions": ["view"],
    "username": "new_user"
  }
  ```
}
