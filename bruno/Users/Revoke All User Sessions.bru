meta {
  name: Revoke All User Sessions
  type: http
  seq: 8
}

post {
  url: {{base_url}}/users/{{user_id}}/sessions/revoke-all
  body: none
  auth: inherit
}

params:path {
  user_id: {{user_id}}
}

assert {
  res.status: eq 200
  res.body.result: isDefined
}

docs {
  # Revoke All User Sessions

  Signs a user out everywhere, for a suspected account compromise. Requires
  permission `user_update`.

  ## Input (path)
  | Param | Type | Required |
  |-------|------|----------|
  | user_id | uuid | yes |

  ## Output `200`
  ```json
  { "result": "ok" }
  ```
}
