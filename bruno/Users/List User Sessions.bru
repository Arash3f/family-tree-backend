meta {
  name: List User Sessions
  type: http
  seq: 6
}

get {
  url: {{base_url}}/users/{{user_id}}/sessions
  body: none
  auth: inherit
}

params:path {
  user_id: {{user_id}}
}

assert {
  res.status: eq 200
}

docs {
  # List User Sessions

  Lists another user's active sessions, for support and account recovery.
  Requires permission `user_update`.

  ## Input (path)
  | Param | Type | Required |
  |-------|------|----------|
  | user_id | uuid | yes |

  ## Output `200`
  ```json
  [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "user_agent": "Mozilla/5.0",
      "ip_address": "127.0.0.1",
      "created_at": "2026-01-01T10:00:00Z",
      "expires_at": "2026-01-08T10:00:00Z",
      "is_current": false
    }
  ]
  ```

  `is_current` is only true when the caller happens to be looking at their own
  account through this endpoint.
}
