meta {
  name: Delete User
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/users/{{user_id}}
  body: none
  auth: inherit
}

params:path {
  user_id: {{user_id}}
}

assert {
  res.status: eq 200
  res.body.result: isDefined
}

docs {
  # Delete User (soft-delete)

  Sets `is_active=false`, detaches tree memberships (and all members of owned
  trees). Tickets and sessions are kept.

  ## Input (path)
  | Param | Type | Required |
  |-------|------|----------|
  | user_id | uuid | yes |

  ## Output `200`
  ```json
  { "result": "ok" }
  ```
}
