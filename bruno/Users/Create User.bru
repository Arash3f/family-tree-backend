meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "username": "new_user",
    "password": "secret123",
    "re_password": "secret123",
    "role_id": "{{role_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
  res.body.username: isString
}

script:post-response {
  if (res.status === 200 && res.body.id) {
    bru.setEnvVar("user_id", String(res.body.id));
  }
}

docs {
  # Create User

  ## Input (`application/json`)
  | Field | Type | Required | Notes |
  |-------|------|----------|-------|
  | username | string | yes | |
  | password | string | yes | |
  | re_password | string | yes | Must match password |
  | role_id | uuid\|null | no | |

  ## Output `200`
  ```json
  {
    "id": "00000000-0000-0000-0000-000000000001",
    "username": "new_user",
    "role_id": "00000000-0000-0000-0000-000000000001"
  }
  ```
}
