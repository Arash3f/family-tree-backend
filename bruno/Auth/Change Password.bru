meta {
  name: Change Password
  type: http
  seq: 7
}

put {
  url: {{base_url}}/auth/password
  body: json
  auth: inherit
}

body:json {
  {
    "current_password": "admin",
    "new_password": "admin",
    "re_password": "admin"
  }
}

assert {
  res.status: eq 200
}

docs {
  # Change Password

  Self-service password change. Does not require `user_update`.
}
