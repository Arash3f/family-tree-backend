meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/logout
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.result: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("access_token", "");
    bru.setEnvVar("refresh_token", "");
  }
}

docs {
  # Logout

  Invalidates the current access token and clears Local env tokens.
}
