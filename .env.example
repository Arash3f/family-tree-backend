JWT_SECRET=local-dev-only-change-me-32chars-min
JWT_ALGORITHM=HS256

# local | development | staging | production
# Weak demo passwords below are rejected when ENVIRONMENT is staging/production.
ENVIRONMENT=local

POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=family_tree
POSTGRES_PORT=5432

POSTGRES_HOST_TEST=db
POSTGRES_USER_TEST=postgres
POSTGRES_PASSWORD_TEST=postgres
POSTGRES_DB_TEST=family_tree_test
POSTGRES_PORT_TEST=5432

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_ROLE_NAME=Admin

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKUP_DIR=/mnt/backups

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=postgres

FLOWER_BASIC_AUTH=admin:admin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001
AUTH_RATE_LIMIT_PER_MINUTE=30

# MinIO (S3-compatible)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=family-tree
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRE_SECONDS=3600

# Published app ports (always on by default)
# API_PORT=8001
# FLOWER_PORT=5555

# Host ports for DBs/brokers are NOT published by default.
# Use: docker compose -f docker/compose.yml -f docker/compose.host-ports.yml --env-file .env up
# POSTGRES_PUBLISH_PORT=5432
# REDIS_PUBLISH_PORT=6379
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
